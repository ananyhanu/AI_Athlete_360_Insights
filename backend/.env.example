AA360_ENVIRONMENT=production
AA360_DATABASE_URL=postgresql+psycopg://aiathlete:replace-me@postgres:5432/aiathlete
AA360_JWT_SECRET=replace-with-a-32-character-minimum-secret-from-your-secret-manager
AA360_DATA_ENCRYPTION_KEY=replace-with-a-fernet-key-from-your-kms-or-secret-manager
AA360_CORS_ORIGINS=https://app.example.in
AA360_TRUSTED_HOSTS=api.example.in
AA360_API_PUBLIC_URL=https://api.example.in
AA360_APP_PUBLIC_URL=https://app.example.in

# Use console only for local development. Production requires SMTP.
AA360_EMAIL_DELIVERY_MODE=smtp
AA360_SMTP_HOST=smtp.example.in
AA360_SMTP_PORT=587
AA360_SMTP_USERNAME=replace-with-smtp-username
AA360_SMTP_PASSWORD=replace-with-smtp-password
AA360_SMTP_FROM=no-reply@example.in
AA360_SMTP_STARTTLS=true

# Use console only for local development. Production requires Twilio credentials.
AA360_MOBILE_OTP_DELIVERY_MODE=twilio
AA360_TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
AA360_TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
AA360_TWILIO_FROM_NUMBER=+15005550006

# Register the Google callback URL below with the Google OAuth client.
# https://api.example.in/v1/auth/google/callback
AA360_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
AA360_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Register the government callback URL below with the approved government IdP.
# https://api.example.in/v1/auth/government/callback
# The IdP userinfo response must include email and email_verified: true.
AA360_GOVERNMENT_SSO_AUTHORIZATION_URL=https://sso.example.gov.in/oauth/authorize
AA360_GOVERNMENT_SSO_TOKEN_URL=https://sso.example.gov.in/oauth/token
AA360_GOVERNMENT_SSO_USERINFO_URL=https://sso.example.gov.in/oauth/userinfo
AA360_GOVERNMENT_SSO_CLIENT_ID=replace-with-government-sso-client-id
AA360_GOVERNMENT_SSO_CLIENT_SECRET=replace-with-government-sso-client-secret
AA360_GOVERNMENT_SSO_SCOPE=openid email profile