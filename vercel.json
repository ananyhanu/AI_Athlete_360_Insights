{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{backend/tests/**,backend/alembic/**,sample_pic/**,sample_video/**,public/mediapipe/**,public/models/**}"
    }
  },
  "rewrites": [
    {
      "source": "/healthz",
      "destination": "/api/index.py"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api/index.py"
    }
  ]
}